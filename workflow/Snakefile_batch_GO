"""
Snakemake workflow for batch GO enrichment analysis
Process multiple samples efficiently
"""

# Configuration
configfile: "workflow/config/batch_go_config.yaml"

# Get sample list from config
SAMPLES = config.get("samples", [])
SAMPLE_NAMES = [s["name"] for s in SAMPLES]
OUTPUT_ROOT = config.get("output_root", "results/batch_go_analysis")

# path to conda environment yaml
CONDA_ENV = "environment.yml"

# Rule to process all samples
rule all:
    input:
        expand(f"{OUTPUT_ROOT}/{{sample}}/report.html", sample=SAMPLE_NAMES)

# Rule 1: Data loading for each sample
rule data_loading:
    output:
        csv = f"{OUTPUT_ROOT}/{{sample}}/standardized.csv"
    params:
        sample = "{sample}",
        config_template = "workflow/config/batch_go_config.yaml"
    log:
        f"{OUTPUT_ROOT}/{{sample}}/logs/data_loading.log"
    run:
        import yaml
        from pathlib import Path
        
        # Load config and find sample-specific settings
        with open(params.config_template) as f:
            config = yaml.safe_load(f)
        
        sample_config = next(s for s in config["samples"] if s["name"] == params.sample)
        
        # Create temporary config for this sample
        temp_config = config.get("base_config", {}).copy()
        temp_config["ROOT_DIR"] = f"{OUTPUT_ROOT}/{params.sample}"
        
        # Merge sample overrides
        if "overrides" in sample_config:
            for key, value in sample_config["overrides"].items():
                if key in temp_config:
                    if isinstance(temp_config[key], dict) and isinstance(value, dict):
                        temp_config[key].update(value)
                    else:
                        temp_config[key] = value
                else:
                    temp_config[key] = value
        
        # Write temporary config
        temp_config_path = f"{OUTPUT_ROOT}/{params.sample}/temp_config.yaml"
        Path(temp_config_path).parent.mkdir(parents=True, exist_ok=True)
        with open(temp_config_path, 'w') as f:
            yaml.dump(temp_config, f, default_flow_style=False)
        
        # Create logs directory
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        
        # Execute data loading
        shell(f"python src/analysis/data_loading.py --config {temp_config_path} --config-section data_loading 2>&1 | tee {log[0]}")

# Rule 2: Filtering for each sample
rule filtering:
    input:
        csv = f"{OUTPUT_ROOT}/{{sample}}/standardized.csv"
    output:
        filtered = f"{OUTPUT_ROOT}/{{sample}}/filtered.csv",
        up_genes = f"{OUTPUT_ROOT}/{{sample}}/filtered_up_genes.txt",
        down_genes = f"{OUTPUT_ROOT}/{{sample}}/filtered_down_genes.txt"
    params:
        sample = "{sample}"
    log:
        f"{OUTPUT_ROOT}/{{sample}}/logs/filtering.log"
    shell:
        """
        python src/analysis/filtering.py \
            --config {OUTPUT_ROOT}/{params.sample}/temp_config.yaml \
            --config-section filtering \
            2>&1 | tee {log}
        """

