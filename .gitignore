# Gitignore for RNA-Seq_GO_analysis project

# Python
__pycache__/
*.pyc
*.pyd
*.pyo

# Virtual environment
venv/
.venv/

# Jupyter Notebooks
.ipynb_checkpoints/

# Data files generated by the pipeline
# As per README, 'data/processed/' and 'output/' are for results.
# 'results/' is also used by batch_runner.py
data/processed/
output/*
results/*
# Keep the 'output' and 'results directory structure
!output/.gitkeep
!results/.gitkeep

ref/
# Keep the 'ref' directory structure
!ref/.gitkeep

# Logs
*.log

# Configuration files
# Ignore all user configs in configs/, but keep templates and README
configs/*
!configs/templates/
!configs/README.md
!configs/.gitkeep

# IDEs and editors
.idea/                  # IntelliJ IDEA / PyCharm
.vscode/                # VS Code
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store               # macOS
Thumbs.db               # Windows

# Build artifacts
build/
dist/
*.egg-info/

# Test and coverage
.coverage
.pytest_cache/

# Environment variables
.env
.flaskenv

# Specific files that might be generated
temp_config_*.yaml # Temporary config files generated by batch_runner

# Snakemake
.snakemake/
*.snakemake_timestamp
