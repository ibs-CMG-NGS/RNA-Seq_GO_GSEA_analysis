"""
Snakemake workflow for batch GSEA analysis
Process multiple samples efficiently
"""

# Configuration
# Note: Use --configfile option when running snakemake instead
# Example: snakemake --snakefile Snakefile_batch_GSEA --configfile configs/templates/batch_gsea_config.yaml --cores 4

# Get sample list from config
SAMPLES = config.get("samples", [])
SAMPLE_NAMES = [s["name"] for s in SAMPLES]
OUTPUT_ROOT = config.get("output_root", "results/batch_gsea_analysis")

# Rule to process all samples
rule all:
    input:
        expand(f"{OUTPUT_ROOT}/{{sample}}/GSEA_Report.xlsx", sample=SAMPLE_NAMES),
        expand(f"{OUTPUT_ROOT}/{{sample}}/plots", sample=SAMPLE_NAMES)

# Rule 1: Data loading for each sample
rule data_loading:
    output:
        csv = f"{OUTPUT_ROOT}/{{sample}}/standardized.csv"
    params:
        sample = "{sample}"
    log:
        f"{OUTPUT_ROOT}/{{sample}}/logs/data_loading.log"
    run:
        import yaml
        from pathlib import Path
        import copy
        
        def deep_merge(base, override):
            """Recursively merge override dict into base dict"""
            result = copy.deepcopy(base)
            for key, value in override.items():
                if key in result and isinstance(result[key], dict) and isinstance(value, dict):
                    result[key] = deep_merge(result[key], value)
                else:
                    result[key] = copy.deepcopy(value)
            return result
        
        # Use the config already loaded by configfile directive
        sample_config = next((s for s in config["samples"] if s["name"] == params.sample), None)
        
        if sample_config is None:
            raise ValueError(f"Sample '{params.sample}' not found in config")
        
        # Create temporary config for this sample with deep copy
        temp_config = copy.deepcopy(config.get("base_config", {}))
        temp_config["ROOT_DIR"] = f"{OUTPUT_ROOT}/{params.sample}"
        
        # Deep merge sample overrides
        if "overrides" in sample_config:
            temp_config = deep_merge(temp_config, sample_config["overrides"])
        
        # Write temporary config
        temp_config_path = f"{OUTPUT_ROOT}/{params.sample}/temp_config.yaml"
        Path(temp_config_path).parent.mkdir(parents=True, exist_ok=True)
        with open(temp_config_path, 'w') as f:
            yaml.dump(temp_config, f, default_flow_style=False)
        
        # Create logs directory
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        
        # Set pipeline log file for Python logging
        pipeline_log = f"{OUTPUT_ROOT}/{params.sample}/logs/pipeline.log"
        
        # Execute data loading
        shell(f"""
            export PIPELINE_LOG_FILE={pipeline_log}
            python src/analysis/data_loading.py \
                --config {temp_config_path} \
                --config-section data_loading \
                2>&1 | tee {log}
        """)

# Rule 2: GSEA analysis for each sample
rule gsea_analysis:
    input:
        csv = f"{OUTPUT_ROOT}/{{sample}}/standardized.csv"
    output:
        report = f"{OUTPUT_ROOT}/{{sample}}/GSEA_Report.xlsx"
    params:
        sample = "{sample}"
    log:
        f"{OUTPUT_ROOT}/{{sample}}/logs/gsea_analysis.log"
    shell:
        """
export PIPELINE_LOG_FILE={OUTPUT_ROOT}/{params.sample}/logs/pipeline.log
        python src/analysis/gsea_analysis.py \
            --config {OUTPUT_ROOT}/{params.sample}/temp_config.yaml \
            --config-section gsea \
            2>&1 | tee {log}
        """

# Rule 3: GSEA plotting for each sample
rule gsea_plot:
    input:
        report = f"{OUTPUT_ROOT}/{{sample}}/GSEA_Report.xlsx"
    output:
        plots_dir = directory(f"{OUTPUT_ROOT}/{{sample}}/plots")
    params:
        sample = "{sample}"
    log:
        f"{OUTPUT_ROOT}/{{sample}}/logs/gsea_plot.log"
    shell:
        """
export PIPELINE_LOG_FILE={OUTPUT_ROOT}/{params.sample}/logs/pipeline.log
        python src/analysis/gsea_plot.py \
            --config {OUTPUT_ROOT}/{params.sample}/temp_config.yaml \
            --config-section gsea_plot \
            2>&1 | tee {log}
        """
