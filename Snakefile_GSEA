"""
Snakemake workflow for GSEA analysis pipeline
"""

import os

# Configuration - require user to provide config file via --configfile
if not workflow.configfiles:
    raise WorkflowError(
        "No configuration file provided!\n"
        "Please run with: snakemake --snakefile Snakefile_GSEA "
        "--configfile configs/YOUR_PROJECT.yaml --cores 4"
    )

CONFIG_FILE = workflow.configfiles[0]

# Validate that user provided a config file
if not config:
    raise WorkflowError(
        "No configuration file provided!\n"
        "Please run with: snakemake --snakefile Snakefile_GSEA "
        "--configfile configs/YOUR_PROJECT.yaml --cores 4"
    )

# Define the output directory
OUTPUT_DIR = config.get("ROOT_DIR", "output/gsea_analysis")
ROOT_DIR = config.get("ROOT_DIR", "output/gsea_analysis")

# Get GSEA output file name from config, with fallback
GSEA_SECTION = config.get("gsea", {})
GSEA_OUTPUT_FILE = GSEA_SECTION.get("output_excel_file", "GSEA_Report.xlsx")

# path to conda environment yaml
CONDA_ENV = "rna-seq-go-gsea-analysis"

# Define all output files from the pipeline
rule all:
    input:
        standardized = f"{OUTPUT_DIR}/standardized.csv",
        gsea_report = f"{OUTPUT_DIR}/{GSEA_OUTPUT_FILE}",
        plots_dir = directory(f"{OUTPUT_DIR}/plots")

# Rule 1: Data loading
rule data_loading:
    output:
        csv = f"{OUTPUT_DIR}/standardized.csv"
    params:
        config = CONFIG_FILE,
        section = "data_loading",
        out_csv = f"{OUTPUT_DIR}/standardized.csv"
    log:
        f"{OUTPUT_DIR}/logs/data_loading.log"
    shell:
        """
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate {CONDA_ENV}
        python src/analysis/data_loading.py \
            --config {params.config} \
            --config-section {params.section} \
            --out-csv {params.out_csv} \
            2>&1 | tee {log}
        """

# Rule 2: GSEA analysis
rule gsea_analysis:
    input:
        csv = f"{OUTPUT_DIR}/standardized.csv"
    output:
        report = f"{OUTPUT_DIR}/{GSEA_OUTPUT_FILE}",
    params:
        config = CONFIG_FILE,
        section = "gsea"
    log:
        f"{OUTPUT_DIR}/logs/gsea_analysis.log"
    shell:
        """
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate {CONDA_ENV}
        python src/analysis/gsea_analysis.py \
            --config {params.config} \
            --config-section {params.section} \
            2>&1 | tee {log}
        """

# Rule 3: GSEA plotting
rule gsea_plot:
    input:
        report = f"{OUTPUT_DIR}/{GSEA_OUTPUT_FILE}"
    output:
        plots_dir = directory(f"{OUTPUT_DIR}/plots")
    params:
        config = CONFIG_FILE,
        section = "gsea_plot"
    log:
        f"{OUTPUT_DIR}/logs/gsea_plot.log"
    shell:
        """
        source $(conda info --base)/etc/profile.d/conda.sh
        conda activate {CONDA_ENV}
        python src/analysis/gsea_plot.py \
            --config {params.config} \
            --config-section {params.section} \
            2>&1 | tee {log}
        """
